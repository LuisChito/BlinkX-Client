---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Blink X · Encuentra lo que se mueve en el cielo infrarrojo">
  <Nav current="historia" />
  <main id="main" style="min-height:100svh;display:grid;place-content:center;gap:1.5rem;padding:var(--gutter)">
    <h1 class="display" style="font-size:clamp(3rem,11vw,9rem)">Algo se movió</h1>
    <p><a class="btn btn-primary" href="/ver">Abrir el visor</a></p>
  </main>
  <Footer />
</Base>
